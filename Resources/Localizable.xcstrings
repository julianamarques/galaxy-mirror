            "value": "Low"
          }
        }
      }
    },
    "Em **Configurações › Opções do desenvolvedor**, ative a **Depuração USB**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Settings › Developer options**, turn on **USB debugging**."
          }
        }
      }
    },
    "Em **Depuração sem fio**, toque em **Parear dispositivo com código de pareamento** e digite aqui o código de seis dígitos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In **Wireless debugging**, tap **Pair device with pairing code** and enter the six-digit code here."
          }
        }
      }
    },
    "Escaneie com o Galaxy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with the Galaxy"
          }
        }
      }
    },
    "Espelhando. Feche a janela do Galaxy para encerrar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirroring. Close the Galaxy window to stop."
          }
