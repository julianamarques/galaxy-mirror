    "Conecte o Galaxy à mesma rede Wi-Fi deste Mac ou ao Mac com um cabo USB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the Galaxy to the same Wi-Fi network as this Mac, or to the Mac with a USB cable."
