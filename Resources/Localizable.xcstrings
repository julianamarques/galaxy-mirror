          "stringUnit": {
            "state": "translated",
            "value": "High"
          }
        }
      }
    },
    "Apagar a tela do Galaxy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the Galaxy's screen"
          }
        }
      }
    },
    "Assegure-se de que o Galaxy esteja ligado, desbloqueado, conectado à mesma rede Wi-Fi que este Mac e com a Depuração sem fio ativada nas Opções do desenvolvedor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the Galaxy is on, unlocked, connected to the same Wi-Fi network as this Mac, and has Wireless debugging turned on in Developer options."
          }
        }
      }
    },
    "Atualizações": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "Baixar Atualização": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Update"
          }
        }
      }
    },
    "Bloquear o Galaxy ao encerrar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the Galaxy when finished"
          }
