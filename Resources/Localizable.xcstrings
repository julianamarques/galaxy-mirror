    "Esquecer este Galaxy…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget This Galaxy…"
          }
        }
      }
    },
    "Este Galaxy foi configurado só pelo cabo. Conecte-o ao Mac com um cabo USB ou clique em Configurar Wi-Fi para usá-lo também sem fio.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Galaxy was set up over cable only. Connect it to the Mac with a USB cable, or click Set Up Wi-Fi to also use it wirelessly."
          }
        }
      }
    },
